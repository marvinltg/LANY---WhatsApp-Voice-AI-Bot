GEMINI_API_KEY=your_gemini_api_key_here

AUDIO_INPUT_DEVICE=CABLE Output (VB-Audio Virtual Cable)
AUDIO_OUTPUT_DEVICE=CABLE Input (VB-Audio Virtual Cable)

STT_PROVIDER=google
TTS_PROVIDER=edge

# VAD (Voice Activity Detection) settings
VAD_MARGIN_DB=15
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_HANGOVER_MS=800
VAD_CALIBRATION_SECS=2.5

# Set to true to save caller speech as WAV files in temp/debug/
AUDIO_DEBUG=false

# ElevenLabs TTS settings
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=Pq1mYZe3vRvysasMNyaJ
ELEVENLABS_TIMEOUT=15
POST_TTS_SETTLE_MS=500

LOG_LEVEL=INFO
